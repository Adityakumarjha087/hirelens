  "info": {
    "title": "HireLens API",
    "description": "Public REST API for the HireLens hiring platform. AI features are delegated to the internal AI service (see docs/ai-service.openapi.json).",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      },
      "cookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "hl_refresh"
      }
    },
    "schemas": {
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "jane@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "example": "Str0ngPassw0rd!"
          },
          "fullName": {
            "type": "string",
            "example": "Jane Doe"
          },
          "role": {
            "type": "string",
            "enum": [
              "CANDIDATE",
              "RECRUITER"
            ]
          },
          "company": {
            "type": "string",
            "example": "Acme Corp"
          }
        },
        "required": [
          "email",
          "password",
          "fullName",
          "role"
        ]
      },
      "LoginDto": {
