# Copy to .env and adjust. Every value has a safe local default in docker-compose.yml.
# Never commit real secrets.

# --- Database
POSTGRES_USER=hirelens
POSTGRES_PASSWORD=hirelens
POSTGRES_DB=hirelens

# --- Backend (NestJS)
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:20200
APP_URL=http://localhost:20200
SEED_ON_START=true
THROTTLE_LIMIT=300
MAIL_FROM="HireLens <no-reply@hirelens.local>"

# --- Object storage (MinIO locally, S3 in production)
S3_BUCKET=hirelens-resumes
S3_ACCESS_KEY=hirelens
S3_SECRET_KEY=hirelens-secret

# --- Service-to-service auth between backend and AI service
AI_SERVICE_TOKEN=dev-internal-token

# --- AI service: LLM provider (fake | anthropic | openai | gemini | ollama)
AI_LLM_PROVIDER=fake
AI_ANTHROPIC_API_KEY=
AI_ANTHROPIC_MODEL=claude-opus-5-5
AI_OPENAI_API_KEY=
AI_GEMINI_API_KEY=
AI_OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- AI service: models (hashing | sentence-transformers) and NER (auto | rule | spacy)
AI_EMBEDDING_PROVIDER=hashing
AI_NER_PROVIDER=auto
# Set to true to bake sentence-transformers + spaCy into the AI image (large download)
AI_INSTALL_ML_EXTRAS=false
